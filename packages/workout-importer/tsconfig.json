{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": ".",
        "composite": true,
        "declaration": true,
        "declarationMap": true,
        "outDir": "dist",
        "paths": {
            "#src/*": ["src/*"]
        },
        "rootDir": "src",
        "sourceMap": true,
        "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
    },
    "include": ["src/**/*.ts"]
}
